# Get a key at https://openrouter.ai/keys (free models still need a key)
OPENROUTER_API_KEY=sk-or-...
# Free model that supports tool calling:
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Comma-separated free fallbacks, used automatically if the primary is rate-limited:
OPENROUTER_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free
